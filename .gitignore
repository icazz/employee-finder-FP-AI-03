# ========================================
# Backend (Python / FastAPI)
# ========================================
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.pyc

# Virtual environment
venv/
env/
.venv/
.env
.env.*

# Streamlit cache (legacy)
.streamlit/

# Model cache (bisa besar, download ulang saat dibutuhkan)
model_cache/
*.bin
*.pt
*.pth

# Data sensitif / file upload sementara
data/uploads/
*.pdf

# Pytest / Coverage / Linting
.pytest_cache/
.coverage
htmlcov/
.ruff_cache/
.mypy_cache/

# ========================================
# Frontend (Node.js / Next.js / React)
# ========================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Next.js build output
.next/
out/
build/
*.tsbuildinfo
next-env.d.ts

# ========================================
# Docker & Infrastructure
# ========================================
# SSL Certificates (Sangat penting agar tidak bocor!)
certs/
*.crt
*.key
*.pem

