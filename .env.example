# =========================================================================
# Employee Finder - Environment Variables Example Template
# =========================================================================

# --- AI & NLP SERVICE CONFIGURATION ---
# Masukkan API Key Anthropic Claude Anda di sini (misal: sk-ant-...)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Masukkan API Key Hugging Face Inference API Anda di sini (misal: hf_...)
HF_API_KEY=your_huggingface_token_here

# Apakah akan menggunakan embedding lokal (sentence-transformers)?
# Set ke false agar tidak membebani memori lokal (menggunakan HF API / TF-IDF saja).
USE_LOCAL_EMBEDDINGS=false

# --- FILE PARSER CONFIGURATION ---
# Ekstensi file yang diperbolehkan (pisahkan dengan koma)
ALLOWED_EXTENSIONS=pdf,docx

# Batas maksimal ukuran file (dalam Megabyte)
MAX_FILE_SIZE_MB=25

# --- SYSTEM CONFIGURATION ---
# Lingkungan runtime aplikasi: development / production
ENVIRONMENT=development
